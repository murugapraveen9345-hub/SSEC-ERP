// UniCore ERP — Production Prisma Database Schema
// Handles Academic, Financial, HR, and Administrative relations

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  FACULTY
  ADMIN
  PARENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  ON_DUTY
  LATE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum UserStatus {
  ACTIVE
  BLOCKED
  SUSPENDED
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  name      String
  role      Role       @default(STUDENT)
  status    UserStatus @default(ACTIVE)
  avatar    String?
  phone     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  studentProfile StudentProfile?
  facultyProfile FacultyProfile?
  staffProfile   StaffProfile?
  notifications  Notification[]
  leaveRequests  LeaveRequest[]
  auditLogs      AuditLog[]
}

model Department {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  hodId     String?
  createdAt DateTime @default(now())

  students StudentProfile[]
  faculty  FacultyProfile[]
  staff    StaffProfile[]
  courses  Course[]
}

model StudentProfile {
  id           String      @id @default(uuid())
  userId       String      @unique
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  regNo        String      @unique
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id])
  year         Int         @default(1)
  section      String      @default("A")
  cgpa         Float       @default(0.0)
  attendance   Float       @default(100.0)
  parentId     String?

  attendanceRecords AttendanceRecord[]
  examResults       ExamResult[]
  feePayments       FeePayment[]
  documentRequests  DocumentRequest[]
}

model FacultyProfile {
  id            String     @id @default(uuid())
  userId        String     @unique
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  designation   String
  departmentId  String
  department    Department @relation(fields: [departmentId], references: [id])
  experience    Int        @default(0)
  workloadHours Int        @default(16)
  isHod         Boolean    @default(false)
  isMentor      Boolean    @default(false)
  courses       Course[]
}

model StaffProfile {
  id           String      @id @default(uuid())
  userId       String      @unique
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleTitle    String      // e.g. "Lab Assistant", "Accounts Officer", "Librarian"
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
}

model Course {
  id           String     @id @default(uuid())
  code         String     @unique
  title        String
  credits      Int        @default(3)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  facultyId    String?
  faculty      FacultyProfile? @relation(fields: [facultyId], references: [id])

  attendanceRecords AttendanceRecord[]
  examSchedules     ExamSchedule[]
  examResults       ExamResult[]
}

model AttendanceRecord {
  id        String           @id @default(uuid())
  studentId String
  student   StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course           @relation(fields: [courseId], references: [id])
  date      DateTime         @default(now())
  status    AttendanceStatus @default(PRESENT)
}

model ExamSchedule {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  examDate  DateTime
  duration  String   @default("3 hrs")
  venue     String
  examType  String   @default("End Semester")
}

model ExamResult {
  id        String         @id @default(uuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course         @relation(fields: [courseId], references: [id])
  internal  Float          @default(0)
  external  Float          @default(0)
  total     Float          @default(0)
  grade     String         @default("A")
  result    String         @default("Pass")
}

model FeePayment {
  id          String         @id @default(uuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount      Float
  category    String
  status      PaymentStatus  @default(PENDING)
  txRef       String?        @unique
  paymentMode String?
  paidAt      DateTime?
  createdAt   DateTime       @default(now())
}

model LeaveRequest {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveType   String
  fromDate    DateTime
  toDate      DateTime
  days        Int         @default(1)
  reason      String
  status      LeaveStatus @default(PENDING)
  reviewedBy  String?
  documentUrl String?
  createdAt   DateTime    @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model DocumentRequest {
  id           String         @id @default(uuid())
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  documentType String
  purpose      String
  status       String         @default("Processing")
  trackingRef  String         @unique
  fileUrl      String?
  createdAt    DateTime       @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String   // e.g. "STUDENT_BLOCKED", "TIMETABLE_PUBLISHED", "GRADE_LOCKED", "LOGIN"
  entity      String   // e.g. "User", "Timetable", "ExamResult", "Fee"
  entityId    String?
  details     String?  // JSON formatted details or description
  ipAddress   String?  @default("127.0.0.1")
  createdAt   DateTime @default(now())
}

model FeeCategory {
  id          String   @id @default(uuid())
  name        String   // "Tuition Fee", "Bus Fee", "Hostel Fee", "Mess Fee"
  amount      Float
  academicYear String  @default("2026-2027")
  dueDate     DateTime
  finePerDay  Float    @default(50.0)
  createdAt   DateTime @default(now())
}

model TimetableSlot {
  id           String   @id @default(uuid())
  departmentId String
  year         Int      @default(1)
  section      String   @default("A")
  dayOfWeek    String   // "Monday", "Tuesday", etc.
  period       Int      // 1 to 7
  courseCode   String
  facultyName  String
  roomNumber   String
  isLab        Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model PlacementDrive {
  id             String   @id @default(uuid())
  companyName    String
  role           String
  packageLpa     Float
  driveDate      DateTime
  minCgpa        Float    @default(6.5)
  allowedDepts   String   // comma-separated "CSE,IT,ECE"
  maxBacklogs    Int      @default(0)
  venue          String   @default("Campus Auditorium")
  status         String   @default("UPCOMING") // "UPCOMING", "ONGOING", "COMPLETED"
  eligibleCount  Int      @default(0)
  createdAt      DateTime @default(now())
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  category  String   @default("GENERAL") // "ACADEMIC", "SECURITY", "NOTIFICATION"
  updatedAt DateTime @updatedAt
}

model RbacPermission {
  id        String   @id @default(uuid())
  role      Role
  module    String   // "STUDENTS", "FACULTY", "TIMETABLE", "FEES", "EXAMS", "PLACEMENTS", "AUDIT"
  canRead   Boolean  @default(false)
  canWrite  Boolean  @default(false)
  canDelete Boolean  @default(false)
  canApprove Boolean @default(false)
}

